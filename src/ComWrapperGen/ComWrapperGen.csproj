<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>comwrap</ToolCommandName>
    <PackageId>comwrap</PackageId>
    <Version>0.1.0</Version>
    <Authors>VB6Converter</Authors>
    <Description>COM wrapper generator using source-generated COM interfaces and ComWrappers.</Description>
    <PackageOutputPath>..\..\artifacts\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

</Project>
