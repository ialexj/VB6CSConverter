[
  // VB.Form — ClientHeight/Left/Top/Width are VB6 IDE design-time persistence properties
  // written to .frm files to record the form's client-area size and position (in twips).
  // They are NOT present in any COM type library (VB6.OLB _Form interface has no Client* members);
  // injecting them here prevents compile errors when InitializeComponent assigns these values.
  {
    "Targets": [ "VB.Form" ],
    "Members": [
      // VB6.OLB exposes Form.Show but does not mark its two parameters optional.
      // Inject the VB6-facing signature so generated stubs emit default values.
      { "Name": "Show", "Kind": "Method", "ReturnType": "void", "Parameters": [
        { "Name": "Modal", "Type": "object", "IsOptional": true, "IsOut": false },
        { "Name": "OwnerForm", "Type": "object", "IsOptional": true, "IsOut": false }
      ] },

      { "Name": "Close", "Kind": "Method", "ReturnType": "void", "Parameters": [] },

      { "Name": "ClientHeight", "Kind": "PropertyGet", "ReturnType": "float", "Parameters": [] },
      { "Name": "ClientHeight", "Kind": "PropertySet", "ReturnType": "void", "Parameters": [] },
      { "Name": "ClientLeft",   "Kind": "PropertyGet", "ReturnType": "float", "Parameters": [] },
      { "Name": "ClientLeft",   "Kind": "PropertySet", "ReturnType": "void", "Parameters": [] },
      { "Name": "ClientTop",    "Kind": "PropertyGet", "ReturnType": "float", "Parameters": [] },
      { "Name": "ClientTop",    "Kind": "PropertySet", "ReturnType": "void", "Parameters": [] },
      { "Name": "ClientWidth",  "Kind": "PropertyGet", "ReturnType": "float", "Parameters": [] },
      { "Name": "ClientWidth",  "Kind": "PropertySet", "ReturnType": "void", "Parameters": [] }
    ]
  }
]
