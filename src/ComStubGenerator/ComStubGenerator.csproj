<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Spectre" Version="0.6.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Extensions.Progress" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VB6Parser\VB6Parser.csproj" />
  </ItemGroup>

  <!-- Build ComQuery x86 into comquery\x86\ -->
  <Target Name="BuildComQueryX86" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ComQuery\ComQuery.csproj"
             Properties="Configuration=$(Configuration);PlatformTarget=x86;OutputPath=$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\comquery\x86\"
             Targets="Build" />
  </Target>

  <!-- Build ComQuery x64 into comquery\x64\ -->
  <Target Name="BuildComQueryX64" AfterTargets="BuildComQueryX86">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ComQuery\ComQuery.csproj"
             Properties="Configuration=$(Configuration);PlatformTarget=x64;OutputPath=$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\comquery\x64\"
             Targets="Build" />
  </Target>
</Project>
