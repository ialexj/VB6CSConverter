<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.6.3" ExcludeAssets="Runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Spectre" Version="0.6.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Extensions.Progress" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VB6Parser\VB6Parser.csproj" />
  </ItemGroup>

  <Target Name="BuildComStubGeneratorX86" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ComStubGenerator\ComStubGenerator.csproj"
             Properties="Configuration=$(Configuration);PlatformTarget=x86;OutputPath=$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\stubs\x86\"
             Targets="Build" />
  </Target>

  <Target Name="BuildComStubGeneratorX64" AfterTargets="BuildComStubGeneratorX86">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\ComStubGenerator\ComStubGenerator.csproj"
             Properties="Configuration=$(Configuration);PlatformTarget=x64;OutputPath=$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\stubs\x64\"
             Targets="Build" />
  </Target>

</Project>
